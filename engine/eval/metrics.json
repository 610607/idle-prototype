{
  "_doc": "Metric registry (docs/eval-interface.md §版本和稳健性). Every id `eval run` / `eval session` writes and every id in bands.json must match one pattern here. `{x}` matches one id segment (letters, digits, underscores). class: probe 局面探针 / result 结果量 / self 自选样本 / model 模型对实测 / llm 玩家反馈. `eval metrics` prints this table.",
  "metrics": [
    { "pattern": "owned.h{N}", "class": "result", "doc": "第 N 小时占有的格数" },
    { "pattern": "ring.h{N}", "class": "result", "doc": "第 N 小时最深的已占环" },
    { "pattern": "ops.h{N}", "class": "result", "doc": "第 N 小时的队员数" },
    { "pattern": "score.h{N}", "class": "result", "doc": "第 N 小时的本轮成果" },
    { "pattern": "intel_in.h{N}", "class": "result", "doc": "到第 N 小时累计的情报收入（含见习任务奖励）" },
    { "pattern": "reach_h.r{K}", "class": "result", "doc": "第一次占到第 K 环的时刻（小时，5 分钟精度；没到为空）" },
    { "pattern": "frontier_win.h{N}", "class": "probe", "doc": "第一支小队按预演能赢的下一环格子比例" },
    { "pattern": "deep_win.h{N}", "class": "probe", "doc": "第一支小队按预演能赢的再下一环格子比例" },
    { "pattern": "power.h{N}", "class": "probe", "doc": "最强小队的战力指数 S（含学说，旧指数）" },
    { "pattern": "rho_frontier.h{N}", "class": "probe", "doc": "最强小队对下一环各格的 ρ 中位数（旧指数）" },
    { "pattern": "route_win.{zone}", "class": "self", "doc": "机器人实际路线战斗的胜率（内圈 / 前线 / 深处），只用来抓预演和实战不一致" },
    { "pattern": "route_battles.frontier", "class": "self", "doc": "在前线打了多少仗" },
    { "pattern": "surge_lost.{zone}", "class": "result", "doc": "来潮失守率（全部 / 内部 / 边缘）" },
    { "pattern": "share.{part}", "class": "result", "doc": "本轮成果中管理、防御、探索各占的比例" },
    { "pattern": "score_rate.peak_h", "class": "result", "doc": "每小时成果最高的时刻（第 6 小时起）" },
    { "pattern": "score_rate.h24_vs_peak", "class": "result", "doc": "第 24 小时的每小时成果占峰值的比例" },
    { "pattern": "stock_h.{res}.h{N}", "class": "result", "doc": "第 N 小时的库存折合几小时收入" },
    { "pattern": "spend_gap.max_h", "class": "result", "doc": "最长的无事可花间隔（小时）" },
    { "pattern": "spend_hours.share", "class": "result", "doc": "有花钱的小时占比" },
    { "pattern": "research.draws", "class": "result", "doc": "研究次数" },
    { "pattern": "hired", "class": "result", "doc": "招募人数" },

    { "pattern": "payoff.hook_h", "class": "result", "doc": "第一个可感爽点（tier ≥ 1）的时刻" },
    { "pattern": "payoff.count.{class}", "class": "result", "doc": "某类可感爽点的次数" },
    { "pattern": "payoff.t.{class}.{k}", "class": "result", "doc": "第 k 次某类爽点的时刻" },
    { "pattern": "payoff.m.research.{k}", "class": "probe", "doc": "第 k 次研究让参考小队模型强度变化的 log2 倍数" },
    { "pattern": "payoff.flip.research.{k}", "class": "probe", "doc": "第 k 次研究让多少格前线由输转赢" },
    { "pattern": "payoff.research.m_max", "class": "probe", "doc": "一轮里单次研究让参考小队模型强度变化的最大 log2 倍数" },
    { "pattern": "payoff.research.flips", "class": "probe", "doc": "一轮里所有研究让前线由输转赢的格数之和" },
    { "pattern": "payoff.ladder_gain.research.{k}", "class": "probe", "doc": "第 k 次研究让最强小队在完整固定标尺上模拟多赢的场数（之后减之前，可为负）" },
    { "pattern": "payoff.research.ladder_gain", "class": "probe", "doc": "一轮里所有研究让固定标尺模拟多赢的场数之和" },
    { "pattern": "payoff.gap_max_h.{period}", "class": "result", "doc": "该时段内相邻可感爽点的最长间隔" },
    { "pattern": "payoff.gap_max_h.big.{period}", "class": "result", "doc": "该时段内相邻“大”爽点（tier ≥ 2）的最长间隔" },
    { "pattern": "payoff.gap_p90_h.{period}", "class": "result", "doc": "该时段内相邻可感爽点间隔的 90 分位" },
    { "pattern": "payoff.visit_hit.h{N}", "class": "result", "doc": "每 N 小时回访一次时，回访窗口里有可感爽点的比例" },
    { "pattern": "payoff.peak_rank", "class": "result", "doc": "每天最大爽点幅度和天序的秩相关（≥ 0 表示峰值不递减）" },
    { "pattern": "payoff.finale", "class": "result", "doc": "最后一天是否有全轮最大或次大的爽点（1 / 0）" },
    { "pattern": "payoff.rate_drop.max", "class": "result", "doc": "相邻 6 小时窗口成果增量的最大降幅" },
    { "pattern": "payoff.novelty.d{k}", "class": "result", "doc": "第 k 天第一次出现的事件和命令数" },
    { "pattern": "payoff.auto_share.d{k}", "class": "result", "doc": "第 k 天规章代做占全部操作的比例" },
    { "pattern": "payoff.lines.{period}", "class": "result", "doc": "该时段内给出可感爽点的成长线数" },
    { "pattern": "payoff.self_sufficient.share", "class": "result", "doc": "防线自给的小时占比" },
    { "pattern": "payoff.power.h{N}", "class": "probe", "doc": "最强小队对固定标尺（第 1～7 环遭遇）的模型强度几何平均" },
    { "pattern": "payoff.growth.power", "class": "probe", "doc": "一轮里模型强度的总增长（log2）" },
    { "pattern": "payoff.sawtooth.power", "class": "probe", "doc": "模型强度增长里来自单次可感跳变的比例" },
    { "pattern": "payoff.ladder.h{N}", "class": "probe", "doc": "第 N 小时最强小队在完整固定标尺（第 1～7 环，再加第 7 环的 6 档加强，共 payoff.ladder.size 场遭遇）上模拟能赢的场数，看得到模型看不到的效果类学说" },
    { "pattern": "payoff.ladder.size", "class": "probe", "doc": "固定标尺的遭遇总场数（常数），payoff.ladder.h{N} 读到它就是顶到天花板" },
    { "pattern": "payoff.growth.ladder", "class": "probe", "doc": "一轮里固定标尺模拟胜场的总增加（最后一小时减第 1 小时）" },
    { "pattern": "payoff.wall.{stat}", "class": "probe", "doc": "战斗墙：前线一格都打不赢的连续小时（次数、最长、占比、墙内无操作占比、靠研究破墙的比例）" },
    { "pattern": "payoff.frontier.margin.h{N}", "class": "probe", "doc": "最强小队对前线各格的最佳模型强度" },
    { "pattern": "payoff.model_ratio.research", "class": "model", "doc": "研究时刻：实测 ÷ 模型（情报一够就研究），中位数" },

    { "pattern": "llm.feel.{stage}.{label}", "class": "llm", "doc": "该阶段回访里各种感受（惊喜 / 平淡 / 失望）的占比" },
    { "pattern": "llm.score.{dim}.{stage}", "class": "llm", "doc": "阶段打分（1～5）" },
    { "pattern": "llm.delight_given_felt", "class": "llm", "doc": "回访窗口里有可感爽点时记“惊喜”的比例" },
    { "pattern": "llm.delight_given_none", "class": "llm", "doc": "回访窗口里没有可感爽点时记“惊喜”的比例" },
    { "pattern": "llm.delight_lift", "class": "llm", "doc": "有可感爽点的回访比没有的回访多出的惊喜率（delight_given_felt − delight_given_none）；越大说明爽点分级越贴近玩家感觉" },
    { "pattern": "session.stale", "class": "llm", "doc": "会话重放后存档指纹对不上（游戏在会话之后改过）：1 是，0 否" },
    { "pattern": "llm.invalid", "class": "llm", "doc": "行动里失败项的占比" }
  ]
}
